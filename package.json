{
  "name": "appium-cli",
  "version": "0.3.1",
  "description": "Token-efficient Appium CLI for coding agents — snapshot refs, tap/fill, webdriverio locator output",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "appium-cli": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
